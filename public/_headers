# Caché sensata para Cloudflare Pages: el HTML siempre fresco,
# los assets con hash inmutables.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/privacidad.html
  Cache-Control: public, max-age=0, must-revalidate

/terminos.html
  Cache-Control: public, max-age=0, must-revalidate
