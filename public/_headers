# Cabeceras de Cloudflare Pages (solo assets estáticos; las Functions de /api
# arman sus propias respuestas).
#
# CSP: la app solo habla con su propio origen (/api). Google OAuth es una
# redirección de página completa (/api/auth/google/start → accounts.google.com),
# así que no necesita entrar en connect-src ni form-action. Google Fonts:
# hoja en fonts.googleapis.com, archivos en fonts.gstatic.com.
#
# OJO: los dos scripts en línea de index.html (autocuración del arranque y tema
# antes del primer pintado) están permitidos por su hash sha256. Si se cambia
# una sola letra de esos scripts, hay que recalcular el hash:
#   python3 -c "import re,hashlib,base64;s=open('index.html').read();[print(base64.b64encode(hashlib.sha256(m.encode()).digest()).decode()) for m in re.findall(r'<script>(.*?)</script>',s,re.S)]"
# Si el hash no coincide la app igual carga; solo se pierde ese script.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-87nIKzAR6j0QFqKCPOM8WTeNA6no+5aFbwRUvrTEHio=' 'sha256-/EZbnMZy8uUSODKDZa64OGk0i2T7XpHL8UGSpjHm14s=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# HTML siempre fresco: así un deploy nuevo nunca apunta a bundles viejos.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/privacidad.html
  Cache-Control: public, max-age=0, must-revalidate

/terminos.html
  Cache-Control: public, max-age=0, must-revalidate

# Bundles de Vite: el nombre lleva hash, se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Íconos y metadatos: nombre fijo, un día de caché con revalidación en segundo plano.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-maskable-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
